{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/u/:slug",
      "destination": "/view.html?slug=:slug"
    },
    {
      "source": "/u/:slug/",
      "destination": "/view.html?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}